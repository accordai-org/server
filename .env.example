# Copy to .env for local development. Never commit .env with real secrets.
# All secrets here are intentionally empty placeholders.

# --- Application metadata ---
APP_NAME=accord
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# --- LLM provider ---
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# --- TensorMux ---
TENSORMUX_API_KEY=
TENSORMUX_BASE_URL=https://api.tensormux.com
TENSORMUX_MODEL=tensormux-default

# --- NeatLogs (see https://docs.neatlogs.com/sdk/python) ---
NEATLOGS_ENABLED=true
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
NEATLOGS_WORKFLOW_NAME=accord-server
NEATLOGS_CAPTURE_LOGS=false
NEATLOGS_SAMPLE_RATE=1.0
NEATLOGS_FLUSH_INTERVAL=5.0
NEATLOGS_BATCH_SIZE=100
NEATLOGS_DEBUG=false

# --- Execution provider ---
EXECUTION_PROVIDER=local
EXECUTION_API_KEY=
EXECUTION_BASE_URL=
EXECUTION_TIMEOUT_SECONDS=60

# --- Database (placeholders) ---
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_ECHO=false
